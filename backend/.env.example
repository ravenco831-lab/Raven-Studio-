# ==============================================================================
# Raven AI Music Studio - Backend Environment Variables
# ==============================================================================

# Port the backend server listens on (Render and Cloud Run inject PORT automatically)
PORT=8080

# Required: Shared bearer secret matching STUDIO_BACKEND_API_KEY in AI Studio Secrets.
# Generate a random 32+ char token (e.g., openssl rand -hex 24).
STUDIO_BACKEND_API_KEY=change-me-to-a-long-random-secret

# Optional: Public HTTPS URL of this deployed backend (used to build download links
# for /generated/* files if behind a reverse proxy). Defaults to request host.
PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# AI Music, Lip-Sync & Image-to-Video Provider Keys (Configure whichever you use)
# ------------------------------------------------------------------------------

# FREE TIER OPTION 1: Hugging Face Inference API (free account token)
# Enables AI instrumental/music generation via facebook/musicgen-small.
HF_API_TOKEN=
HF_MUSIC_MODEL=facebook/musicgen-small

# FREE STARTER CREDITS / PAY-AS-YOU-GO OPTION 2: Replicate API
# Enables vocal/instrumental music, audio-driven lip-sync (SadTalker/Wav2Lip),
# and Image-to-Video generation.
REPLICATE_API_TOKEN=
REPLICATE_MUSIC_MODEL=meta/musicgen
REPLICATE_LIPSYNC_MODEL=cjwbw/sadtalker
REPLICATE_I2V_MODEL=stability-ai/stable-video-diffusion

# OPTION 3: Custom Music API endpoint (for Suno/Udio-compatible REST gateways)
MUSIC_GEN_API_URL=
MUSIC_GEN_API_KEY=
